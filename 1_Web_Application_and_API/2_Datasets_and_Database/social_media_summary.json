      "weekday_mean": 3.75,
      "mean_difference": 0.77,
      "t_statistic": 36.744,
      "p_value": 0.0,
      "is_significant": true,
      "conclusion": "Weekend screen time is significantly higher by 0.77 hours (p < 0.001)."
    },
    "platform_screen_time_anova": {
      "test_name": "One-Way ANOVA (Screen Time Across Platforms)",
      "hypothesis": "H\u2080: Mean daily screen time is identical across all social platforms. H\u2081: At least one platform has a significantly different screen time.",
      "f_statistic": 11.826,
      "p_value": 0.0,
      "is_significant": true,
      "conclusion": "Significant variation in screen time across platforms (p < 0.05). Platforms like TikTok and Instagram command higher user attention."
    },
    "post_type_engagement_anova": {
      "test_name": "One-Way ANOVA (Engagement Across Post Types)",
